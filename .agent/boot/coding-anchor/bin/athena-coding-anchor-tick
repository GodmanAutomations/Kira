#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="$ROOT/state"
mkdir -p "$STATE_DIR"

STAMP="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
cat > "$STATE_DIR/last-heartbeat.json" <<JSON
{
  "status": "active",
  "checked_at": "$STAMP",
  "root": "$ROOT"
}
JSON

printf 'heartbeat: %s\n' "$STAMP"
printf 'state: %s\n' "$STATE_DIR/last-heartbeat.json"
