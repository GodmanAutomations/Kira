#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TASK_DIR="$ROOT/tasks"
mkdir -p "$TASK_DIR"

TYPE="auto"
NAME="task"
FILES="TBD"
ACTION="TBD"
VERIFY="TBD"
DONE="TBD"
NAME_SET=0

usage() {
  cat <<'USAGE'
Usage:
  athena-coding-anchor-task "task name" [--files FILES] [--action ACTION] [--verify VERIFY] [--done DONE] [--type TYPE]

Creates an ignored XML task handhold for one verification-gated slice.
USAGE
}

xml_escape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --files)
      shift
      [ "$#" -gt 0 ] || { printf 'missing value for --files\n' >&2; exit 2; }
      FILES="$1"
      ;;
    --action)
      shift
      [ "$#" -gt 0 ] || { printf 'missing value for --action\n' >&2; exit 2; }
      ACTION="$1"
      ;;
    --verify)
      shift
      [ "$#" -gt 0 ] || { printf 'missing value for --verify\n' >&2; exit 2; }
      VERIFY="$1"
      ;;
    --done)
      shift
      [ "$#" -gt 0 ] || { printf 'missing value for --done\n' >&2; exit 2; }
      DONE="$1"
      ;;
    --type)
      shift
      [ "$#" -gt 0 ] || { printf 'missing value for --type\n' >&2; exit 2; }
      TYPE="$1"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      if [ "$NAME_SET" -eq 0 ]; then
        NAME="$1"
        NAME_SET=1
      else
        printf 'unexpected argument: %s\n' "$1" >&2
        exit 2
      fi
      ;;
  esac
  shift
done

SAFE_SLUG="$(printf '%s' "$NAME" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._-' '-' | sed 's/^-//; s/-$//')"
if [ -z "$SAFE_SLUG" ]; then
  SAFE_SLUG="task"
fi

STAMP="$(date '+%Y%m%d-%H%M%S')"
FILE="$TASK_DIR/$STAMP-$SAFE_SLUG.xml"

ESC_TYPE="$(xml_escape "$TYPE")"
ESC_NAME="$(xml_escape "$NAME")"
ESC_FILES="$(xml_escape "$FILES")"
ESC_ACTION="$(xml_escape "$ACTION")"
ESC_VERIFY="$(xml_escape "$VERIFY")"
ESC_DONE="$(xml_escape "$DONE")"

cat > "$FILE" <<XML
<task type="$ESC_TYPE">
  <name>$ESC_NAME</name>
  <files>$ESC_FILES</files>
  <action>$ESC_ACTION</action>
  <verify>$ESC_VERIFY</verify>
  <done>$ESC_DONE</done>
</task>
XML

printf '%s\n' "$FILE"
