#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if REPO_ROOT="$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)"; then
  :
else
  REPO_ROOT="$(cd "$ROOT/../../.." && pwd)"
fi

PASSES=1
SCOPE="Kira next useful work"
RUN_DOCTOR=1
CREATE_TASK=0

usage() {
  cat <<'USAGE'
Usage:
  athena-coding-anchor-autoloop [scope] [--passes N] [--task] [--no-doctor]

Creates an ignored Kira auto-loop report that composes status, doctor,
open-loop inventory, routing, task handholds, verification, and stop gates.

The auto-loop is a conductor: it makes the next slices obvious and safe. It
does not edit project files, stage, commit, push, contact services, or bypass
human/agent judgment.

Options:
  --passes N    Plan N bounded passes. Capped at 12.
  --task        Also create an ignored atomic task handhold for pass 1.
  --no-doctor   Skip the doctor gate when a narrower check is intentional.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --passes)
      shift
      if [ "$#" -eq 0 ]; then
        printf 'missing value for --passes\n' >&2
        exit 2
      fi
      PASSES="$1"
      ;;
    --no-doctor)
      RUN_DOCTOR=0
      ;;
    --task)
      CREATE_TASK=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      SCOPE="$1"
      ;;
  esac
  shift
done

case "$PASSES" in
  ''|*[!0-9]*)
    printf 'passes must be a positive integer\n' >&2
    exit 2
    ;;
esac

if [ "$PASSES" -lt 1 ]; then
  printf 'passes must be at least 1\n' >&2
  exit 2
fi

if [ "$PASSES" -gt 12 ]; then
  printf 'passes capped at 12 to avoid runaway planning loops\n' >&2
  PASSES=12
fi

slug="$(printf '%s' "$SCOPE" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//' | cut -c1-60)"
[ -n "$slug" ] || slug="auto-loop"
stamp="$(date '+%Y%m%d-%H%M%S')"
OUT_DIR="$ROOT/autoloops"
mkdir -p "$OUT_DIR"
OUT="$OUT_DIR/$stamp-$slug.md"

STATUS_TMP="$(mktemp)"
DOCTOR_TMP="$(mktemp)"
trap 'rm -f "$STATUS_TMP" "$DOCTOR_TMP"' EXIT

"$ROOT/bin/kira-coding-anchor-status" > "$STATUS_TMP" 2>&1 || true

DOCTOR_RESULT="skipped"
if [ "$RUN_DOCTOR" -eq 1 ]; then
  if "$ROOT/bin/kira-coding-anchor-doctor" > "$DOCTOR_TMP" 2>&1; then
    DOCTOR_RESULT="pass"
  else
    DOCTOR_RESULT="fail"
  fi
fi

dirty_count="$(git -C "$REPO_ROOT" status --short 2>/dev/null | wc -l | tr -d ' ')"
task_count="$(find "$ROOT/tasks" -maxdepth 1 -name '*.xml' -type f 2>/dev/null | wc -l | tr -d ' ')"
spec_count="$(find "$ROOT/specs" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')"
open_active="$(awk '/^## Active/{flag=1; next} /^## /{flag=0} flag && /^- /{print}' "$ROOT/OPEN-LOOPS.md" 2>/dev/null | sed 's/^- //')"

priority_1="Execute requested scope: $SCOPE"
if [ "$DOCTOR_RESULT" = "fail" ]; then
  priority_1="Repair failing doctor checks before widening scope"
elif [ "$dirty_count" != "0" ]; then
  priority_1="Inspect and verify existing dirty work before starting another slice"
elif [ -n "$open_active" ]; then
  priority_1="$(printf '%s\n' "$open_active" | head -1)"
fi

task_file=""
if [ "$CREATE_TASK" -eq 1 ]; then
  task_files="Relevant files from the status snapshot; inspect before editing and do not widen scope."
  task_action="$priority_1"
  task_verify="Run git diff --check; run bin/kira-coding-anchor-doctor for boot-packet changes; rerun the auto-loop after the slice."
  task_done="One bounded slice is verified, or an exact blocker is reported with the next handhold."
  task_file="$("$ROOT/bin/kira-coding-anchor-task" "$priority_1" \
    --files "$task_files" \
    --action "$task_action" \
    --verify "$task_verify" \
    --done "$task_done")"
fi

{
  printf '# Kira Auto-Loop Report\n\n'
  printf 'Scope: %s\n\n' "$SCOPE"
  printf 'Generated: %s\n\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')"
  printf 'Repo: `%s`\n\n' "$REPO_ROOT"
  printf 'Passes requested: %s\n\n' "$PASSES"

  printf '## Status Snapshot\n\n'
  printf '```text\n'
  cat "$STATUS_TMP"
  printf '```\n\n'

  printf '## Health Gate\n\n'
  printf -- '- Doctor: %s\n' "$DOCTOR_RESULT"
  if [ "$DOCTOR_RESULT" != "skipped" ]; then
    printf -- '- Doctor output captured in this report and receipt directory.\n'
  fi
  printf '\n'

  if [ "$DOCTOR_RESULT" = "fail" ]; then
    printf '```text\n'
    tail -80 "$DOCTOR_TMP"
    printf '```\n\n'
  fi

  printf '## Inventory\n\n'
  printf -- '- Dirty paths: %s\n' "$dirty_count"
  printf -- '- Existing generated tasks: %s\n' "$task_count"
  printf -- '- Existing generated specs: %s\n' "$spec_count"
  printf -- '- Open-loop source: `OPEN-LOOPS.md`\n\n'

  printf '## Task Handhold\n\n'
  if [ -n "$task_file" ]; then
    printf -- '- Created: `%s`\n' "$task_file"
    printf -- '- Status: ignored runtime artifact with prefilled files, action, verify, and done fields.\n\n'
  else
    printf -- '- Not created. Rerun with `--task` when an XML task handhold would help.\n\n'
  fi

  printf '## Priority Queue\n\n'
  printf '1. %s\n' "$priority_1"
  printf '2. Route through `KIRA-USE-MAP.md` and `SKILL-ROUTER.md` before broad work.\n'
  printf '3. Convert the chosen slice into one atomic task with files, action, verify, and done conditions.\n'
  printf '4. Run deterministic verification before creating another slice.\n'
  printf '5. Use readiness/checkpoint helpers only after verified durable changes.\n\n'

  printf '## Loop Passes\n\n'
  i=1
  while [ "$i" -le "$PASSES" ]; do
    printf '### Pass %s\n\n' "$i"
    if [ "$i" -eq 1 ]; then
      printf -- '- Action: %s\n' "$priority_1"
    else
      printf -- '- Action: continue only if pass %s verified and the next slice remains inside `%s`.\n' "$((i - 1))" "$SCOPE"
    fi
    printf -- '- Files: smallest relevant files only; discover with targeted search before editing.\n'
    printf -- '- Verify: run the narrow check for touched files, then `bin/kira-coding-anchor-doctor` for boot-packet changes.\n'
    printf -- '- Stop if: doctor fails, verification is unclear, scope widens, or a public/paid/credential/destructive gate appears.\n\n'
    i="$((i + 1))"
  done

  printf '## Next Handhold\n\n'
  if [ "$DOCTOR_RESULT" = "fail" ]; then
    printf 'Fix the doctor failure first; do not stack feature work on a failing boot packet.\n'
  elif [ "$dirty_count" != "0" ]; then
    printf 'Inspect the dirty paths and decide whether they belong to the current slice before editing more.\n'
  else
    printf 'Start pass 1 with the priority queue item, verify it, then rerun this helper for the next pass.\n'
  fi
} > "$OUT"

printf '%s\n' "$OUT"

if [ "$DOCTOR_RESULT" = "fail" ]; then
  exit 1
fi
